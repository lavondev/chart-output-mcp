{
  "name": "@chartoutput/mcp",
  "version": "1.1.1",
  "mcpName": "io.github.jgaddy95/chart-output-mcp",
  "description": "MCP server for Chart-Output — render charts, branded cards and waterfall explanations (PNG, SVG, WebP, PDF) from any AI agent",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "chart-output-mcp": "build/index.js"
  },
  "files": [
    "build",
    "examples"
  ],
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chart",
    "visualization",
    "chart-output",
    "chartjs",
    "png",
    "image",
    "waterfall",
    "brand-kit",
    "pdf"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  }
}
